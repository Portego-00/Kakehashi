{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": 4
    },
    "packageId": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "enum": [
        "integration-demo",
        "learning-content"
      ]
    },
    "scope": {
      "enum": [
        "display-only",
        "display-and-synonyms"
      ]
    },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "kanji",
                    "vocabulary",
                    "kana_vocabulary",
                    "radical"
                  ]
                },
                "word": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "meaningsEn": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "readingsJa": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "updatedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "meaningBasisSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "type",
                "word",
                "meaningsEn",
                "readingsJa",
                "level",
                "updatedAt",
                "meaningBasisSha256"
              ],
              "additionalProperties": false
            },
            "meaning": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reviewStatus": {
                  "type": "string",
                  "enum": [
                    "demo",
                    "draft",
                    "editorial-reviewed"
                  ]
                }
              },
              "required": [
                "primary",
                "alternatives",
                "reviewStatus"
              ],
              "additionalProperties": false
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "properties": {
                      "ja": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "ja",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "sourceSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "translation": {
                    "type": "string",
                    "minLength": 1
                  },
                  "usage": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reviewStatus": {
                    "type": "string",
                    "enum": [
                      "demo",
                      "draft",
                      "editorial-reviewed"
                    ]
                  }
                },
                "required": [
                  "source",
                  "sourceSha256",
                  "translation",
                  "usage",
                  "reviewStatus"
                ],
                "additionalProperties": false
              }
            },
            "synonymAnswers": {
              "type": "object",
              "properties": {
                "values": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reviewStatus": {
                  "enum": [
                    "demo",
                    "draft",
                    "editorial-reviewed"
                  ]
                }
              },
              "required": [
                "values",
                "reviewStatus"
              ],
              "additionalProperties": false
            },
            "mnemonics": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "meaningMnemonic": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "translation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reviewStatus": {
                      "enum": [
                        "demo",
                        "draft",
                        "editorial-reviewed"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "sourceSha256",
                    "translation",
                    "reviewStatus"
                  ],
                  "additionalProperties": false
                },
                "readingMnemonic": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "translation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reviewStatus": {
                      "enum": [
                        "demo",
                        "draft",
                        "editorial-reviewed"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "sourceSha256",
                    "translation",
                    "reviewStatus"
                  ],
                  "additionalProperties": false
                },
                "meaningHint": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "translation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reviewStatus": {
                      "enum": [
                        "demo",
                        "draft",
                        "editorial-reviewed"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "sourceSha256",
                    "translation",
                    "reviewStatus"
                  ],
                  "additionalProperties": false
                },
                "readingHint": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sourceSha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "translation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reviewStatus": {
                      "enum": [
                        "demo",
                        "draft",
                        "editorial-reviewed"
                      ]
                    }
                  },
                  "required": [
                    "source",
                    "sourceSha256",
                    "translation",
                    "reviewStatus"
                  ],
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "source",
            "meaning",
            "examples"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "properties": {
                      "type": {
                        "enum": [
                          "radical",
                          "kana_vocabulary"
                        ]
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "mnemonics": {
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "readingMnemonic"
                          ]
                        },
                        {
                          "required": [
                            "readingHint"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "packageId",
    "language",
    "name",
    "version",
    "generatedAt",
    "purpose",
    "scope",
    "subjects"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WaniKani learning content translation package v4"
}
