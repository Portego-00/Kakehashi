{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "schemaVersion": {
      "const": 3
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "purpose": {
      "enum": [
        "integration-demo",
        "learning-content"
      ]
    },
    "scope": {
      "enum": [
        "display-only",
        "display-and-synonyms"
      ]
    },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[1-9][0-9]*$": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "kanji",
                    "vocabulary",
                    "kana_vocabulary",
                    "radical"
                  ]
                },
                "word": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 256
                },
                "meaningsEn": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "minItems": 1,
                  "maxItems": 64
                },
                "readingsJa": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "maxItems": 64
                },
                "level": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 60
                },
                "updatedAt": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256
                },
                "meaningBasisSha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "type",
                "word",
                "meaningsEn",
                "readingsJa",
                "level",
                "updatedAt",
                "meaningBasisSha256"
              ],
              "additionalProperties": false
            },
            "meaning": {
              "type": "object",
              "properties": {
                "primary": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "alternatives": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "maxItems": 32
                },
                "reviewStatus": {
                  "type": "string",
                  "enum": [
                    "demo",
                    "draft",
                    "editorial-reviewed"
                  ]
                }
              },
              "required": [
                "primary",
                "alternatives",
                "reviewStatus"
              ],
              "additionalProperties": false
            },
            "examples": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "properties": {
                      "ja": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      },
                      "en": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4096
                      }
                    },
                    "required": [
                      "ja",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "sourceSha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "translation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "usage": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192
                  },
                  "reviewStatus": {
                    "type": "string",
                    "enum": [
                      "demo",
                      "draft",
                      "editorial-reviewed"
                    ]
                  }
                },
                "required": [
                  "source",
                  "sourceSha256",
                  "translation",
                  "usage",
                  "reviewStatus"
                ],
                "additionalProperties": false
              },
              "maxItems": 100
            },
            "synonymAnswers": {
              "type": "object",
              "properties": {
                "values": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "reviewStatus": {
                  "enum": [
                    "demo",
                    "draft",
                    "editorial-reviewed"
                  ]
                }
              },
              "required": [
                "values",
                "reviewStatus"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "source",
            "meaning",
            "examples"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "maxProperties": 12000
    }
  },
  "required": [
    "$schema",
    "schemaVersion",
    "packageId",
    "language",
    "name",
    "version",
    "generatedAt",
    "purpose",
    "scope",
    "subjects"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed WaniKani display translation package v1"
}
