{
  "name": "kakehashi",
  "main": "expo-router/entry",
  "version": "1.6.0",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "check:update-assets": "node ./scripts/check-expo-dom-assets.mjs",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "generate:jlpt-vocabulary": "node ./scripts/generateJlptVocabularyData.mjs",
    "generate:kanji-etymology": "node ./scripts/generateKanjiEtymologyData.mjs",
    "refresh:kanji-etymology": "node ./scripts/generateKanjiEtymologyData.mjs --refresh-catalog",
    "import:wanikani-patterns-repo": "node ./scripts/importWaniKaniPatternsFromRepo.mjs",
    "scrape:wanikani-patterns": "node ./scripts/scrapeWaniKaniPatterns.mjs",
    "scrape:wanikani-patterns:retry-failures": "ONLY_RETRY_PREVIOUS_FAILURES=1 node ./scripts/scrapeWaniKaniPatterns.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "ios:simulator": "node ./scripts/build-ios-simulator.mjs"
  },
