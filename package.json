  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@jest/environment-jsdom-abstract": "~30.5.2",
    "@react-native/jest-preset": "^0.88.0",
    "@react-navigation/native-stack": "7.9.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "^24.0.3",
    "@types/pako": "^2.0.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "jest-fetch-mock": "^3.0.3",
    "jsdom": "^20.0.3",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "./jest.preset.cjs",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|wanakana|standard-navigation)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/test.js",
      "<rootDir>/test.ts",
      "<rootDir>/web/",
      "<rootDir>/output/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/output/"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "resolver": "react-native-reanimated/jest/resolver"
  }
}
