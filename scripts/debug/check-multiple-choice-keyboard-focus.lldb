# With an unanswered multiple-choice question visible in an iOS debug build:
# xcrun lldb --batch --attach-pid APP_PID --source scripts/debug/check-multiple-choice-keyboard-focus.lldb
# This checks the actual native keyboard responder, which mocked React tests cannot verify.
expression -l objc -- NSString *(^taskCheckKeyboardFocus)(void) = ^NSString * { UIWindow *taskKeyboardWindow = [[[UIApplication sharedApplication] windows] firstObject]; [taskKeyboardWindow endEditing:YES]; NSMutableArray *taskKeyboardViews = [NSMutableArray arrayWithObject:taskKeyboardWindow]; while ([taskKeyboardViews count]) { UIView *taskKeyboardView = [taskKeyboardViews firstObject]; [taskKeyboardViews removeObjectAtIndex:0]; if ([taskKeyboardView isKindOfClass:(Class)NSClassFromString(@"RNCEKVExternalKeyboardView")]) { [taskKeyboardView performSelector:@selector(focus)]; if (![taskKeyboardView isFirstResponder]) return @"FAIL: focus leaves keyboard view without first responder"; (void)[(id)taskKeyboardView handleCommand:@"blur" args:@[]]; if ([taskKeyboardView isFirstResponder]) return @"FAIL: blur command leaves keyboard view focused"; [taskKeyboardView performSelector:@selector(focus)]; return [taskKeyboardView isFirstResponder] ? @"PASS: native keyboard focus and blur commands work" : @"FAIL: keyboard view cannot refocus"; } [taskKeyboardViews addObjectsFromArray:[taskKeyboardView subviews]]; } return @"NO_KEYBOARD_VIEW: open a multiple-choice question first"; }; taskCheckKeyboardFocus()
detach
quit
