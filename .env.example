# Supabase public client config. The anon key is safe to ship only with audited RLS.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_ISSUE_MEDIA_BUCKET=

# Optional public origin for approved, published custom-pack pronunciation audio.
# No key is required; leave unset until the release manifest contains hosted files.
EXPO_PUBLIC_CUSTOM_VOCABULARY_AUDIO_SUPABASE_URL=

# Optional override for the trusted web deployment's full native notebook endpoint.
# Unset/blank defaults to https://kakehashiapp.com/api/notebooks/native in all builds.
# iOS Simulator development: http://127.0.0.1:3000/api/notebooks/native
# This URL is public; never place tokens or server credentials in it.
EXPO_PUBLIC_NOTEBOOKS_API_URL=

# Public/accepted-client provider config. These are embedded in EAS builds and updates.
EXPO_PUBLIC_MAL_CLIENT_ID=
EXPO_PUBLIC_MAL_API_BASE_URL=https://api.myanimelist.net/v2
EXPO_PUBLIC_YOUTUBE_API_KEY=
EXPO_PUBLIC_YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
# App-owned catalog search credentials only. Personal account linking uses the
# Client ID saved in Settings > Music Playback; it never needs a user client secret.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_CLIENT_KEY=
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=kakehashi://spotify-auth
EXPO_PUBLIC_SPOTIFY_AUTHORIZATION_URL=https://accounts.spotify.com/authorize
EXPO_PUBLIC_SPOTIFY_API_BASE_URL=https://api.spotify.com/v1
EXPO_PUBLIC_SPOTIFY_ACCOUNTS_URL=https://accounts.spotify.com/api/token
EXPO_PUBLIC_AZURE_TRANSLATOR_SUBSCRIPTION_KEY=
EXPO_PUBLIC_AZURE_TRANSLATOR_REGION=
EXPO_PUBLIC_AZURE_TRANSLATOR_API_BASE_URL=https://api.cognitive.microsofttranslator.com

# Optional user/provider integrations. Runtime UI usually stores these per-device.
EXPO_PUBLIC_JPDB_API_KEY=

# Debug flags
EXPO_PUBLIC_LOG_URL_READER=
