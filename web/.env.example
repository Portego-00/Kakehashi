# Optional local-only token used by server-side smoke tests. Never expose this as NEXT_PUBLIC_*.
WANIKANI_API_TOKEN=

# At least 32 random characters. Used only on the server to encrypt HttpOnly sessions.
SESSION_SECRET=

# Server-only music provider credentials. Spotify powers catalog search; YouTube
# resolves an embeddable video. Never prefix the client secret or API key with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Optional shared community database. Without these, development uses web/.data/community.json.
# An anonymous key enables native-compatible development access and production reads.
# Production writes require the server-only service-role key and the community RPC migration.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
COMMUNITY_ADMIN_USER_IDS=
