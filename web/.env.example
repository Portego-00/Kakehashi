# Optional local-only token used by server-side smoke tests. Never expose this as NEXT_PUBLIC_*.
WANIKANI_API_TOKEN=

# At least 32 random characters. Used only on the server to encrypt HttpOnly sessions.
SESSION_SECRET=

# Server-only music provider credentials. Spotify powers catalog search; YouTube
# resolves an embeddable video. Never prefix the client secret or API key with NEXT_PUBLIC_.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# MyAnimeList uses the same accepted-client configuration as the Expo app.
# Keep the real value in EAS and use `npm run dev:expo-env` locally.
EXPO_PUBLIC_MAL_CLIENT_ID=
EXPO_PUBLIC_MAL_API_BASE_URL=https://api.myanimelist.net/v2

# Shared Supabase database for Community, complete Standard NHK articles, and usage analytics.
# Without these, Community is unavailable, Standard News falls back to RSS summaries, and
# app-session/study-time analytics remain local to the browser. The service-role key is
# preferred for production server writes; the anonymous key supports the shared analytics RPC.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Development only: explicitly opt in to the local web/.data/community.json board.
COMMUNITY_LOCAL_STORE=0
COMMUNITY_ADMIN_USER_IDS=
